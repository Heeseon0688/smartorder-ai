APP_ENV=production
# Neon dashboard: pooled runtime URL; direct migration URL. Keep sslmode query.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/neondb?sslmode=require&channel_binding=require
MIGRATION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require&channel_binding=require
FRONTEND_URL=https://YOUR-PROJECT.vercel.app
ALLOWED_ORIGINS=["https://YOUR-PROJECT.vercel.app"]
COOKIE_SECURE=true
SEED_DEMO=false
ENABLE_DEMO_LINK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LOG_LEVEL=info
FORWARDED_ALLOW_IPS=*
