# Native local development. Docker uses the root .env instead.
APP_ENV=development
DATABASE_URL=sqlite:///./smartorder.db
# Neon pooled DATABASE_URL + direct MIGRATION_DATABASE_URL (sslmode=require).
MIGRATION_DATABASE_URL=
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# No automatic schema/data initialization. Run app.manage commands explicitly.
SEED_DEMO=false
ENABLE_DEMO_LINK=true
COOKIE_SECURE=false
DEMO_ADMIN_EMAIL=admin@smartburger.demo
DEMO_ADMIN_PASSWORD=SmartBurger!2026
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
