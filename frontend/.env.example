# Browser-visible values only. Never place database credentials or keys here.
VITE_API_BASE_URL=/api
# Local: blank uses Vite websocket proxy. Cloud build derives WSS from BACKEND_ORIGIN.
VITE_WS_URL=
# Vercel build-time public backend origin (no credentials, no /api suffix).
# BACKEND_ORIGIN=https://YOUR-SERVICE.onrender.com
VITE_DEMO_MODE=true
